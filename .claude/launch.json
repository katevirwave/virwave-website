{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "aikei-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "aikei-app",
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    }
  ]
}